{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "obsidian": ["node_modules/obsidian"] },
    "typeRoots": ["node_modules/@types", "node_modules/obsidian"],
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es2019",
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "importHelpers": false,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "lib": ["dom", "es2019", "scripthost"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
